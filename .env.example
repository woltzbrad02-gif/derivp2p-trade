# Copy this file to .env and set a strong password
# The server refuses nothing but you should NOT run with the default password in production
ADMIN_PASSWORD=Joan5078

# Port the server listens on (ignored on Vercel)
PORT=3000

# Optional: strengthen signed session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Required on Vercel so /admin can SAVE trade fields (repo is read-only otherwise).
# Create a GitHub PAT with Contents: Read and write on this repo.
GITHUB_TOKEN=
GITHUB_REPO=ecocashloans/DERIV-APP
GITHUB_BRANCH=main
